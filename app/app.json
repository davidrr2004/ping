{
  "expo": {
    "name": "Ping",
    "slug": "ping",
    "version": "1.0.0",
    "sdkVersion": "49.0.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Ping needs access to the microphone to detect important sounds around you.",
        "NSSpeechRecognitionUsageDescription": "Ping optionally uses speech recognition to enhance event detection."
      }
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO",
        "VIBRATE"
      ]
    }
  }
}
